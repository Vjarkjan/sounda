     void EnableChannel(u16 value) {
+        // DSi DMA starts on the channel enable edge. Match melonDS 1.1's
+        // upstream Teakra integration; the existing SetZ trigger is for 3DS.
+        u16 newly_enabled = value & ~enable_channel;
+        for (unsigned i = 0; i < channels.size(); ++i) {
+            if (newly_enabled & (1 << i))
+                DoDma(i);
+        }
         enable_channel = value;
     }
